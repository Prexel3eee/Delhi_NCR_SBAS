  "incident_log": [
    {
      "id": "INC-001",
      "severity": "medium",
      "summary": "Idempotency check used a prefix with an exact-match API, causing 7 duplicate pilot jobs and 35 wasted credits.",
      "root_cause": "hyp3_sdk HyP3.find_jobs(name=...) performs an exact name match. The check passed 'delhi_ncr_sbas_a27_v1_pilot', which matched 0 jobs even after 7 were submitted.",
      "evidence": "find_jobs(name='delhi_ncr_sbas_a27_v1_pilot') -> 0 matches; find_jobs(name='delhi_ncr_sbas_a27_v1_pilot_20250211_20250223') -> 2 matches",
      "fix": "List multi-burst jobs and match exact names locally; never pass name= to find_jobs.",
      "tests_added": "tests/test_pilot_idempotency.py (8 tests, incl. a guard that find_existing never passes name=)",
      "verified": "A third --submit run submitted 0 jobs and credits remained at 7930.",
      "production_risk_mitigated": "At production scale (336 jobs) the same bug would have wasted 1680 credits."
    },
    {
      "id": "INC-002",
      "severity": "low",
      "summary": "First production retrieval run was killed by a transient ASF DNS outage after 47/336 products.",
      "root_cause": "Connection and job listing were not retried, and hyp3.refresh(Batch) issued one HTTP request per job (336 per cycle), maximising exposure to a network blip.",
      "impact": "No permanent loss: the 47 downloaded products and their hashed inventory were intact, and retrieval is resumable.",
      "fix": "connect_hyp3/fetch_jobs retry with capped linear backoff and raise a typed NetworkUnavailable; the batch is listed in a single find_jobs(job_type=...) call; the initial connection waits for the API; the loop rebuilds the session.",
      "tests_added": "tests/test_production_retrieval.py (9 offline tests)",
      "verified": "After connectivity returned, all 336 jobs were SUCCEEDED and the ledger reconciled with 0 orphans in either direction."
    },
    {
      "id": "INC-004",
      "severity": "low",
      "summary": "Parallel MintPy inversion died at dask cluster start: module numpy has no attribute bool8.",
      "root_cause": "MintPy creates a bare LocalCluster(), which enables the dask dashboard; the dashboard imports bokeh, and this bokeh build still references np.bool8, removed in NumPy 2.x. Upgrading dask/distributed does not help - the reference is in bokeh, not dask.",
      "fix": "scripts/run_mintpy.py restores the removed alias (a pure alias for np.bool_) before importing any MintPy CLI. No numerical behaviour changes.",
      "verified": "Bare LocalCluster() starts; the baseline inversion then completed in 13m25s."
    },
    {
      "id": "INC-005",
      "severity": "medium",
      "summary": "First RAW-vs-ERA5 comparison used the wrong velocity file and reported a spurious 15.49 mm/yr RMS difference.",
      "root_cause": "MintPy's velocityERA5.h5 is not the ERA5-corrected velocity - its FILE_PATH provenance points at inputs/ERA5.h5 (the delay file). The corrected product is velocity.h5 derived from timeseries_ERA5.h5.",
      "evidence": "direct least-squares fit to timeseries_ERA5.h5: velocity.h5 agrees to 0.0008 mm/yr, velocityERA5.h5 disagrees by 3.72 mm/yr",
      "fix": "Both comparison scripts now resolve branch products by reading FILE_PATH metadata instead of guessing filename patterns.",
      "corrected_result": "0.52 mm/yr RMS (median +0.01, max 5.1), not 15.49 mm/yr",
      "related": "The same class of mistake had already made the DEM branch look identical to ERA5 (false null)."
    }
  ],
