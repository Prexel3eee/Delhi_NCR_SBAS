# credentials - never commit
.netrc
.env
*.token

# large/generated data
data/*
!data/**/.gitkeep
*.zip
*.tif

# python
__pycache__/
*.pyc

# macOS
.DS_Store

# derived MintPy rasters and HDF5 (regenerable from data/)
mintpy/*_clipped/
mintpy/*_work/
mintpy/**/*.h5

# mintpy_input_v1 small-file snapshot is tracked; the large stack is hash-pinned
!freeze/mintpy_input_v1/**
